{
  "name": "termix-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Command-line interface for Termix — a thin wrapper around the Termix HTTP API, usable by humans, scripts and AI agents.",
  "bin": {
    "termix": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "start": "node dist/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "commander": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
